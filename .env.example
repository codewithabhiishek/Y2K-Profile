# PROFILE.EXE — environment variables (optional)
#
# The shipped build is fully self-contained: users paste their Anthropic
# key in-app (stored in localStorage, sent directly to api.anthropic.com).
# When you deploy behind a server proxy (see callClaude() in index.html),
# move the keys here so they never touch the browser.

# Required only for a server-proxied Mode A deployment.
ANTHROPIC_API_KEY=

# Optional — raises GitHub API rate limits from 60/hr to 5,000/hr.
GITHUB_TOKEN=
